<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Concierge</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version).0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests assert on decisions that have no business being public API but
         every business being covered — "is this item waiting to be indexed" is one
         of them, and getting it wrong recreates the invisible state it exists to
         expose. -->
    <InternalsVisibleTo Include="Jellyfin.Plugin.Concierge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\concierge.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to the ABI the owner's server actually runs. Compiling against the
         real 10.11.11 assemblies is half of what stands in for having no local
         Jellyfin to test against; dotnet test is the other half. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

</Project>
